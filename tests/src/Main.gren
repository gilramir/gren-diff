module Main exposing (main)

import Node
import PerfTest
import Test.Runner.UnitNode as U
import UnifiedTests


main : Node.SimpleProgram a
main =
    U.run
        { name = "gren-diff"
        , version = "1.0.2"
        , suites =
            [ UnifiedTests.tests
            , PerfTest.tests
            ]
        }
