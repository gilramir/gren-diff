module UnifiedTests exposing (tests)

import Expect exposing (Expectation)
import Task
import Test.Runner.UnitNode as U

import UnifiedDiff exposing (unifiedDiffStrings, unifiedDiffArrays)


text1 =
    """
    This is line 1.
    This is line 2.
    This is line 3.
    This is line 4.
    This is line 5.
    """

changeLine1 =
    """
    Changed
    This is line 2.
    This is line 3.
    This is line 4.
    This is line 5.
    """

changeLine3 =
    """
    This is line 1.
    This is line 2.
    Changed
    This is line 4.
    This is line 5.
    """

changeLine5 =
    """
    This is line 1.
    This is line 2.
    This is line 3.
    This is line 4.
    Changed
    """

removeLine1 =
    """
    This is line 2.
    This is line 3.
    This is line 4.
    This is line 5.
    """

removeLine3 =
    """
    This is line 1.
    This is line 2.
    This is line 4.
    This is line 5.
    """

removeLine5 =
    """
    This is line 1.
    This is line 2.
    This is line 3.
    This is line 4.
    """

tests : U.Suite
tests =
    U.suite
        { name = "UnifiedDiff"
        , setUpSuite = U.noSuiteFixture
        , tearDownSuite = U.noTearDown
        , setUp = U.noFixture
        , tearDown = U.noTearDown
        , tests =
            [ U.test "empty vs empty" <| \_ ->
                unifiedDiffStrings "" ""
                    |> Expect.equal ""
                    |> Task.succeed

            , U.test "same vs same" <| \_ ->
                unifiedDiffStrings text1 text1
                    |> Expect.equal ""
                    |> Task.succeed

            , U.test "change line 1" <| \_ ->
                unifiedDiffStrings text1 changeLine1
                    |> Expect.equal
                        """
                        @@ -1,4 +1,4 @@
                        -This is line 1.
                        +Changed
                         This is line 2.
                         This is line 3.
                         This is line 4.
                        """
                    |> Task.succeed

            , U.test "change line 3" <| \_ ->
                unifiedDiffStrings text1 changeLine3
                    |> Expect.equal
                        """
                        @@ -1,5 +1,5 @@
                         This is line 1.
                         This is line 2.
                        -This is line 3.
                        +Changed
                         This is line 4.
                         This is line 5.
                        """
                    |> Task.succeed

            , U.test "change line 5" <| \_ ->
                unifiedDiffStrings text1 changeLine5
                    |> Expect.equal
                        """
                        @@ -2,4 +2,4 @@
                         This is line 2.
                         This is line 3.
                         This is line 4.
                        -This is line 5.
                        +Changed
                        """
                    |> Task.succeed

            , U.test "remove line 1" <| \_ ->
                unifiedDiffStrings text1 removeLine1
                    |> Expect.equal
                        """
                        @@ -1,4 +1,3 @@
                        -This is line 1.
                         This is line 2.
                         This is line 3.
                         This is line 4.
                        """
                    |> Task.succeed

            , U.test "remove line 3" <| \_ ->
                unifiedDiffStrings text1 removeLine3
                    |> Expect.equal
                        """
                        @@ -1,5 +1,4 @@
                         This is line 1.
                         This is line 2.
                        -This is line 3.
                         This is line 4.
                         This is line 5.
                        """
                    |> Task.succeed

            , U.test "remove line 5" <| \_ ->
                unifiedDiffStrings text1 removeLine5
                    |> Expect.equal
                        """
                        @@ -2,4 +2,3 @@
                         This is line 2.
                         This is line 3.
                         This is line 4.
                        -This is line 5.
                        """
                    |> Task.succeed

            , U.test "unifiedDiffArrays" <| \_ ->
                unifiedDiffArrays [ "one", "two", "three" ] [ "one", "TWO", "three" ]
                    |> Expect.equal "@@ -1,3 +1,3 @@\n one\n-two\n+TWO\n three"
                    |> Task.succeed

            , U.test "an empty old side is 0,0, as GNU diff writes it" <| \_ ->
                unifiedDiffArrays [] [ "a", "b" ]
                    |> Expect.equal "@@ -0,0 +1,2 @@\n+a\n+b"
                    |> Task.succeed

            , U.test "an empty new side is 0,0" <| \_ ->
                unifiedDiffArrays [ "a", "b" ] []
                    |> Expect.equal "@@ -1,2 +0,0 @@\n-a\n-b"
                    |> Task.succeed
            ]
        }
